        android:scaleX="0.827" android:scaleY="0.827"
        android:translateY="-36">
        <path
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M 262 876 L 262 470 A 250 250 0 0 1 762 470 L 762 876 Z
                              M 352 876 L 352 488 A 160 160 0 0 1 672 488 L 672 876 Z
                              M 472 742 a 40 40 0 1 0 80 0 a 40 40 0 1 0 -80 0 Z"/>
    </group>
</vector>
