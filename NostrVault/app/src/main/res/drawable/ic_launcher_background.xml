<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive-icon background: the dark tile from the Mac/iOS app icon
  (HavenApp/Resources/AppIcon-source.svg, gradient "f"). Full-bleed on the
  108dp canvas so any launcher mask crops into gradient, never an edge.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="1024"
    android:viewportHeight="1024">
    <path android:pathData="M0,0h1024v1024h-1024z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="307" android:endY="1024">
                <item android:offset="0" android:color="#FF191008"/>
                <item android:offset="1" android:color="#FF000000"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
