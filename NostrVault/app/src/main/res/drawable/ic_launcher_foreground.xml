<?xml version="1.0" encoding="utf-8"?>
<!--
    Adaptive-icon foreground: the lit arch, redrawn from AppIcon-source.svg in
    108dp adaptive coordinates.

    Sizing is driven by the mask, not by the bounding box. The arch is a wide,
    flat-bottomed shape, so its lower corners sit further from the tile centre
    than its height suggests; fitting the box into the 66dp safe band still lets
    a circular mask (the Pixel launcher default) shave the base and shoulders.
    The mark is therefore scaled until its extreme corner is inside the 66dp
    safe circle: 52.4dp tall, corner radius 32.94 against the 33 limit.

    Geometry is the SVG's, rescaled by 52.4/656 about the mark's true bounding
    box (x 262..762, y 220..876 — the semicircular cap rises a full radius above
    the springline). Colours are the shipped ramp from Services/Theming.swift:
    #E67326 primary, #FA9447 light. The SVG's overlay/screen blends and its two
    noise filters have no VectorDrawable equivalent and are dropped; at launcher
    size they contribute nothing but file weight.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Pier: the arch wall. -->
    <path android:pathData="M34.031,80.2 L34.031,47.77 A19.97,19.97 0 0 1 73.969,47.77 L73.969,80.2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="37.226" android:startY="27.8"
                android:endX="62.786" android:endY="80.2">
                <item android:offset="0" android:color="#FFA8825A"/>
                <item android:offset="0.58" android:color="#FF33251A"/>
                <item android:offset="1" android:color="#FF33251A"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Top-light along the pier edge. -->
    <path
        android:pathData="M34.031,80.2 L34.031,47.77 A19.97,19.97 0 0 1 73.969,47.77 L73.969,80.2 Z"
        android:strokeWidth="0.799">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="27.8"
                android:endX="0" android:endY="80.2">
                <item android:offset="0" android:color="#52FFFFFF"/>
                <item android:offset="0.5" android:color="#1AFFFFFF"/>
                <item android:offset="1" android:color="#00FFFFFF"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- The opening, unlit. -->
    <path android:pathData="M41.22,80.2 L41.22,49.207 A12.781,12.781 0 0 1 66.78,49.207 L66.78,80.2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="36.427"
                android:endX="0" android:endY="80.2">
                <item android:offset="0" android:color="#FF0A0602"/>
                <item android:offset="1" android:color="#8C0A0602"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- The light in the opening. -->
    <path android:pathData="M41.22,80.2 L41.22,49.207 A12.781,12.781 0 0 1 66.78,49.207 L66.78,80.2 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54" android:centerY="66.192"
                android:gradientRadius="24.075">
                <item android:offset="0" android:color="#F2FA9447"/>
                <item android:offset="0.5" android:color="#57E67326"/>
                <item android:offset="1" android:color="#00E67326"/>
            </gradient>
        </aapt:attr>
    </path>

    <!-- Threshold line. -->
    <path
        android:pathData="M41.22,80.2 L41.22,49.207 A12.781,12.781 0 0 1 66.78,49.207 L66.78,80.2 Z"
        android:strokeColor="#80FA9447"
        android:strokeWidth="0.559"/>

    <!-- The lock on the threshold. -->
    <path android:pathData="M54,66.301 a3.195,3.195 0 1 1 0,6.39 a3.195,3.195 0 1 1 0,-6.39 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0" android:startY="66.301"
                android:endX="0" android:endY="72.691">
                <item android:offset="0" android:color="#FF0A0602"/>
                <item android:offset="1" android:color="#8C0A0602"/>
            </gradient>
        </aapt:attr>
    </path>
    <path
        android:pathData="M54,66.301 a3.195,3.195 0 1 1 0,6.39 a3.195,3.195 0 1 1 0,-6.39 Z"
        android:strokeColor="#D9FA9447"
        android:strokeWidth="0.559"/>
</vector>
