    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="#FFFFFF"
        android:fillType="evenOdd"
        android:pathData="M4.378,22 L4.378,9.622 A7.622,7.622 0 0 1 19.622,9.622 L19.622,22 Z M7.122,22 L7.122,10.171 A4.878,4.878 0 0 1 16.878,10.171 L16.878,22 Z M12,16.695 a1.22,1.22 0 1 1 0,2.44 a1.22,1.22 0 1 1 0,-2.44 Z"/>
</vector>
